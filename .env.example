# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/college-erp

# JWT secret — 64 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# Changing it signs everyone out. (Login length is set per role in src/lib/authConfig.ts.)
JWT_SECRET=your-64-byte-random-secret-here

# Node environment
NODE_ENV=development

# Vercel Blob storage — required for teacher-uploaded resource files (and assignment attachments).
# In production, this is auto-injected once a Blob store is connected to the Vercel project
# (Storage tab → create/connect a Blob store). For local dev, copy the token from that store's
# ".env.local" tab in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
